# SERVER
PORT=8000
APP_HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
# Optional: Override URL for password reset page (if not set, uses CLIENT_URL/reset-password)
RESET_PASSWORD_URL=
MONGODB_URL_DEV=mongodb://127.0.0.1:27017
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=45000
AUTH_BYPASS=true
SYNC_INDEXES=true
MAIN_PLANT_ID=69e9eb3438468e881627507a
PROCUREMENT_PLANT_IDS=69e9eb3438468e881627507a
CENTRAL_DISTRIBUTION_PLANT_ID=69eeaaf92eac4c18b2483acc

# TOKEN
JWT_ACCESS_TOKEN_KEY=dev_access_secret_key
JWT_VERIFY_TOKEN_KEY=dev_verify_secret_key
JWT_REFRESH_TOKEN_KEY=dev_refresh_secret_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_VERIFY_EXPIRATION=30d
RESET_PASSWORD_TOKEN_EXPIRATION_MINUTES=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# COOKIE_SECURE / COOKIE_SAME_SITE da bo: cookie refresh tu suy ra theo giao thuc request
# (HTTPS -> SameSite=None+Secure cho cross-site; HTTP local -> SameSite=Lax). Xem auth.service.ts.
# Nho deploy backend qua HTTPS thi production moi gui duoc cookie.

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=dummy_cloud
CLOUDINARY_API_KEY=dummy_key
CLOUDINARY_API_SECRET=dummy_secret

# NODE MAILER
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=test@example.com
EMAIL_PASSWORD=dummy_password
EMAIL_FROM=test@example.com
EMAIL_FROM_NAME=Device Management System

# WEB PUSH / PWA NOTIFICATIONS
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:test@example.com

# PAYOS
PAYOS_CLIENT_ID=dummy_client_id
PAYOS_API_KEY=dummy_api_key
PAYOS_CHECKSUM_KEY=dummy_checksum_key

# NGROK
NGROK_AUTHTOKEN=dummy_ngrok_token

# LOCAL AI HELP ASSISTANT
# Install Ollama and pull a model, for example: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=75000
