# SERVER
PORT=8000
APP_HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
# Optional: Override URL for password reset page (if not set, uses CLIENT_URL/reset-password)
RESET_PASSWORD_URL=
MONGODB_URL_DEV=mongodb://127.0.0.1:27017
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=45000
AUTH_BYPASS=true
SYNC_INDEXES=true
MAIN_PLANT_ID=69e9eb3438468e881627507a
PROCUREMENT_PLANT_IDS=69e9eb3438468e881627507a
CENTRAL_DISTRIBUTION_PLANT_ID=69eeaaf92eac4c18b2483acc

# TOKEN
JWT_ACCESS_TOKEN_KEY=dev_access_secret_key
JWT_VERIFY_TOKEN_KEY=dev_verify_secret_key
JWT_REFRESH_TOKEN_KEY=dev_refresh_secret_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_VERIFY_EXPIRATION=30d
RESET_PASSWORD_TOKEN_EXPIRATION_MINUTES=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# COOKIE_SECURE / COOKIE_SAME_SITE da bo: cookie refresh tu suy ra theo giao thuc request
# (HTTPS -> SameSite=None+Secure cho cross-site; HTTP local -> SameSite=Lax). Xem auth.service.ts.
# Nho deploy backend qua HTTPS thi production moi gui duoc cookie.

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=dummy_cloud
CLOUDINARY_API_KEY=dummy_key
CLOUDINARY_API_SECRET=dummy_secret

# NODE MAILER
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=test@example.com
EMAIL_PASSWORD=dummy_password
EMAIL_FROM=test@example.com
EMAIL_FROM_NAME=Device Management System

# WEB PUSH / PWA NOTIFICATIONS
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:test@example.com

# TELEGRAM NOTIFICATION FALLBACK
# 1) Create bot with @BotFather, set token and username (without @ is ok).
# 2) Set webhook to: https://your-api-domain.com/api/telegram/webhook
#    Include secret_token = TELEGRAM_WEBHOOK_SECRET when calling setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# INTERNAL CRON WAKE-UP
# Preferred: POST internal routes with header x-internal-cron-secret.
# UptimeRobot free fallback for production reminders:
# GET /api/internal/production-reminders?secret=<INTERNAL_CRON_SECRET> every 5 minutes over HTTPS.
INTERNAL_CRON_SECRET=

# PAYOS
PAYOS_CLIENT_ID=dummy_client_id
PAYOS_API_KEY=dummy_api_key
PAYOS_CHECKSUM_KEY=dummy_checksum_key

# NGROK
NGROK_AUTHTOKEN=dummy_ngrok_token

# LOCAL AI HELP ASSISTANT
# Install Ollama and pull a model, for example: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=75000

# AI PROVIDER / 9ROUTER
# Production Render khong dung 127.0.0.1 neu proxy 9Router khong chay cung server.
# Hay dung endpoint /v1 trong dashboard 9Router, vi du: https://xxxx.abc-tunnel.us/v1
AI_ENABLED=true
AI_PROVIDER=9router
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_DEFAULT=gh/claude-haiku-4.5
AI_MODEL_JSON=oc/deepseek-v4-flash-free
AI_TIMEOUT_MS=90000
# Optional: số ngày lưu trace trợ lý đã redaction (7-365 ngày).
AI_TRACE_TTL_DAYS=90
# Optional: override model vision rieng cho OCR hoa don/phieu cap. PHAI la model KHONG-"thinking"
# (vd gemini-2.5-flash). KHONG dung gemini-2.5-pro: model thinking dot token budget -> JSON cat cut.
# Luu y: OCR KHONG con ke thua AI_VISION_MODEL nua -> set rieng o day neu muon doi.
AI_OCR_MODEL=gc/gemini-2.5-flash
# Optional: model vision DU PHONG cho lan thu cuoi (cung phai non-thinking). Mac dinh gc/gemini-2.5-flash.
AI_OCR_FALLBACK_MODEL=gc/gemini-2.5-flash
# Optional: map model theo tac vu. Neu bo trong, app da co default trong code.
AI_FEATURE_MODELS={"ocr-invoice":"gc/gemini-2.5-flash","ocr-supply-request":"gc/gemini-2.5-flash","material-match":"kr/claude-haiku-4.5"}

# GOOGLE VERTEX PROXY
# Neu bat true: cac luong OCR/quyet dinh anh se thu Vertex truoc, loi/hit quota thi fallback ve AI_PROVIDER/9Router.
VERTEX_ENABLED=false
VERTEX_PROXY_URL=
VERTEX_PROXY_KEY=
VERTEX_MODEL_FAST=gemini-2.5-flash-lite
VERTEX_MODEL_VISION=gemini-2.5-flash
VERTEX_MODEL_VERIFY=gemini-2.5-flash-lite
VERTEX_IMAGE_ENABLED=false
VERTEX_MODEL_IMAGE=gemini-3.1-flash-image
VERTEX_TIMEOUT_MS=90000
