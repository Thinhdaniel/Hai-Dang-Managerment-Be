{
  "name": "device-management-be",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "dev:watch": "nodemon --watch src --ext ts,json --exec \"npm run build && node dist/index.js\"",
    "build": "rimraf dist && tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate:asset-ownership": "node scripts/backfill-asset-ownership-from-borrowings.mjs",
    "migrate:maintenance-plant": "node scripts/backfill-maintenance-plant-snapshot.mjs",
    "migrate:maintenance-plant:dry": "node scripts/backfill-maintenance-plant-snapshot.mjs --dry-run",
    "ai:regression": "node scripts/ai-regression.mjs",
    "ai:policy-check": "tsx scripts/ai-policy-regression.ts",
    "ai:action-smoke": "tsx scripts/ai-guided-action-smoke.ts",
    "ai:quality-gate": "npm run ai:policy-check && npm run ai:regression -- --max-bad 0 --max-p95-ms 45000",
    "test:briefing": "tsx --test src/services/__tests__/executive-briefing.helpers.test.ts src/services/__tests__/ai-provider-json-retry.test.ts",
    "test:production": "tsx --test src/services/__tests__/production.helpers.test.ts src/services/__tests__/production-price.helpers.test.ts src/services/__tests__/production-monitor.helpers.test.ts src/services/__tests__/production-board.helpers.test.ts src/services/__tests__/production-forecast.helpers.test.ts src/services/__tests__/production-export.service.test.ts src/services/__tests__/production-opening-balance.helpers.test.ts src/services/__tests__/production-qc-opening-balance.helpers.test.ts src/services/__tests__/production-report.helpers.test.ts src/services/__tests__/production-report-export.service.test.ts src/services/__tests__/production-reminder.helpers.test.ts src/services/__tests__/production-qc-report.helpers.test.ts",
    "cleanup:dry": "node scripts/data-cleanup-dry-run.mjs",
    "cleanup:apply": "node scripts/data-cleanup-apply.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.4.1",
    "mongoose-paginate-v2": "^1.9.4",
    "morgan": "^1.10.1",
    "msedge-tts": "^2.0.6",
    "multer": "^2.1.1",
    "nanoid": "^5.1.7",
    "nodemailer": "^8.0.5",
    "rimraf": "^6.1.3",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/streamifier": "^0.1.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  }
}
